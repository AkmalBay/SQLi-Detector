[Unit]
Description=SQL Injection Telegram Bot Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/your/project/sqli
Environment=PATH=/path/to/your/project/sqli/venv/bin:$PATH
ExecStart=/path/to/your/project/sqli/venv/bin/python telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
